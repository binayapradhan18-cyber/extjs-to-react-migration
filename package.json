{
  "name": "extjs-to-react-migration",
  "version": "1.0.0",
  "private": true,
  "description": "Strangler-fig migration of an Ext JS module to React: legacy shell, React widget, typed interop bridge, codemods and playbook.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/bridge",
    "codemods",
    "react-app",
    "legacy-extjs"
  ],
  "scripts": {
    "dev:legacy": "npm run build:widget -w @migration/react-app && npm run dev -w @migration/legacy-extjs",
    "dev:react": "npm run dev -w @migration/react-app",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @migration/bridge && npm run build -w @migration/react-app && npm run build -w @migration/legacy-extjs",
    "codegen": "npm run codegen -w @migration/codemods",
    "preview:legacy": "npm run preview -w @migration/legacy-extjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
